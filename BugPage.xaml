<?xml version="1.0" encoding="utf-8" ?>
<!--
    BUG REPRO: Button.LayoutButton NRE during Shell GoToAsync navigation on iOS
    ============================================================================
    When GoToAsync("..") is called with buttons still attached to the visual tree,
    Shell's outgoing transition animation causes iOS's QuartzCore layout commit
    (CA::Transaction::flush_as_runloop_observer) to call WrapperView.LayoutSubviews
    on those buttons while they are in a half-disposed state, triggering a
    NullReferenceException inside Microsoft.Maui.Controls.Button.LayoutButton.
    The managed exception crosses the native boundary and becomes a fatal NSException
    (SIGABRT on device).

    Crash path observed in the wild:
      CA::Transaction::flush_as_runloop_observer
        -> WrapperView.LayoutSubviews                 (MAUI iOS wrapper)
          -> xamarin_process_managed_exception         (Xamarin runtime bridge)
            [managed NRE: Button.LayoutButton]

    Workaround: remove the button container from its parent Grid before GoToAsync.
    See OnDismissClicked below.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiButtonLayoutNreRepro.BugPage"
             Title="Bug Page"
             BackgroundColor="#1a1a2e"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!--
        The Grid structure mirrors the real-world trigger:
          Row 0 = main content (video view / body) — heavy native disposable
                  to widen the layout-disposal race window
          Row 1 = button row that remains attached during GoToAsync (the bug)
    -->
    <Grid RowDefinitions="*,Auto">

        <WebView Grid.Row="0"
                 x:Name="VideoView" />

        <!--
            x:Name="ButtonRow" is the key:  OnDismissClicked references it
            so the workaround can remove it before GoToAsync.
        -->
        <HorizontalStackLayout x:Name="ButtonRow"
                               Grid.Row="1"
                               Spacing="16"
                               Padding="16,8,16,48"
                               HorizontalOptions="Center"
                               VerticalOptions="End">

            <Button x:Name="MuteButton"
                    Text="Mute"
                    Clicked="OnMuteClicked" />

            <Button x:Name="FlipButton"
                    Text="Flip"
                    Clicked="OnFlipClicked" />

            <Button x:Name="DismissButton"
                    Text="Dismiss"
                    BackgroundColor="#d32f2f"
                    TextColor="White"
                    Clicked="OnDismissClicked" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>
